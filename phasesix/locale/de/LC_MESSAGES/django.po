msgstr "Modifikatoren hinzufügen"

#: characters/templates/characters/sidebar/spell.html:44
msgid "Spell cost"
msgstr "Zauber Kosten"

#: characters/templates/characters/sidebar/spell.html:55
#: magic/templates/magic/_basespell_widget.html:22
#: magic/templates/magic/basespell_detail.html:39
